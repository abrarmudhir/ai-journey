        "sql__max_lines": 600,
    }

    # Map file extensions to config keys
    EXTENSION_CONFIG_KEYS = {
        ".py": "python",
        ".pyw": "python",
        ".pyx": "python",
        ".js": "javascript",
        ".jsx": "javascript",
        ".mjs": "javascript",
        ".cjs": "javascript",
