}


class PreviewType(Enum):
    NONE = "none"
    PARTIAL = "partial"
    FULL = "full"
    ERROR = "error"

@dataclass
class FilePreview:
    contents: str
    preview_type: PreviewType
    mime_type: str

@dataclass
class SymlinkInfo:
    target: str
    target_exists: bool
    is_broken: bool
    is_circular: bool = False

@dataclass
class Node:
    name: str
    extension: str
    path: str
    type: str  # "file", "dir", or "symlink"
    size: int = None
    last_modified: str = None
    preview: FilePreview = None
    children: list = None
    symlink_info: SymlinkInfo = None

    def to_dict(self):
        """Convert Node to dictionary for JSON serialization."""
        result = {
            'name': self.name,
            'extension': self.extension,
            'path': self.path,
            'type': self.type,
            'size': self.size,
            'last_modified': self.last_modified
        }

        if self.preview:
            result['preview'] = {
                'contents': self.preview.contents,
                'preview_type': self.preview.preview_type.value,
                'mime_type': self.preview.mime_type
            }

        if self.symlink_info:
            result['symlink_info'] = {
                'target': self.symlink_info.target,
                'target_exists': self.symlink_info.target_exists,
                'is_broken': self.symlink_info.is_broken,
                'is_circular': self.symlink_info.is_circular
            }

        if self.children:
            result['children'] = [child.to_dict() for child in self.children]

        return result


class BaseHandler:
    MIME_TYPES = []
    FILE_EXTENSIONS = []
    DEFAULT_MIME_TYPE = None
    defaults = {}

    def __init__(self, config):
        self.config = {}
        if self.namespace:
            handler_config = config.get(self.namespace, {})
            for key, value in self.defaults.items():
                self.config[key] = handler_config.get(key, value)

    @property
    def namespace(self):
        return self.__class__.__name__

    def _handle(self, file_path, file_extension=None):
        """
        Returns (contents, preview_type, mime_type: optional)
        If mime_type is None, DEFAULT_MIME_TYPE will be used.

        Args:
            file_path: Path to the file to handle
            file_extension: File extension (e.g., '.py', '.js') for extension-specific handling
        """
        raise NotImplementedError("Subclasses must implement handle()")

    @final
    def handle(self, file_path, file_extension=None):
        """
        Handle a file and returns a FilePreview

        Args:
            file_path: Path to the file to handle
            file_extension: File extension for extension-specific handling

        Returns:
            FilePreview: The file preview object
        """
        try:
            values = self._handle(file_path, file_extension=file_extension)
        except Exception:
            return FilePreview(
                contents="",
                mime_type=self.DEFAULT_MIME_TYPE,
                preview_type=PreviewType.ERROR
            )
        if len(values) == 2:
            contents, preview_type = values
            mime_type = self.DEFAULT_MIME_TYPE
        else:
            contents, preview_type, mime_type = values

        return FilePreview(
            contents=contents,
            mime_type=mime_type,
            preview_type=preview_type
        )


class JupyterNotebookHandler(BaseHandler):
    FILE_EXTENSIONS = [".ipynb"]
    DEFAULT_MIME_TYPE = "application/x-ipynb+json"
    defaults = {
        "max_cells": -1,
        "include_output": True
    }

    def _handle(self, file_path, file_extension=None):
        import nbformat
        from nbconvert import HTMLExporter

        html_exporter = HTMLExporter()
        html_exporter.exclude_input = False  # Include inputs in the output
        html_exporter.embed_images = True   # Embed images in the output
        with open(file_path, "r", encoding="utf-8") as f:
            notebook_content = f.read()

        notebook_node = nbformat.reads(notebook_content, as_version=4)

        body, _ = html_exporter.from_notebook_node(notebook_node)

        return body, PreviewType.FULL


class BaseImageHandler(BaseHandler):
    MIME_TYPES = ["image/"]
    FILE_EXTENSIONS = [".png", ".jpg", ".jpeg", ".gif", ".bmp", ".tiff", ".webp"]
    DEFAULT_MIME_TYPE = "image/png"

    def _handle(self, file_path, file_extension=None):
        # In real implementation: base64 encode the image
        import base64

        with open(file_path, 'rb') as f:
            encoded = base64.b64encode(f.read()).decode('utf-8')
        return encoded, PreviewType.FULL


