        ".css": "css",
        ".scss": "css",
        ".sass": "css",
        ".less": "css",
        ".sql": "sql",
    }

    def _get_extension_config(self, file_extension, config_key):
        """
        Get configuration value for a specific extension.
        Looks up {extension_key}__{config_key} first, then falls back to config_key.

        This method can be used by subclasses to get extension-specific config.
        """
        extension_key = self.EXTENSION_CONFIG_KEYS.get(file_extension)
        if extension_key:
            specific_key = f"{extension_key}__{config_key}"
            if specific_key in self.config:
                return self.config[specific_key]
        return self.config.get(config_key)

    def _read_file_lines(self, file_path):
        """
        Read file and return lines.
        Helper method that can be reused by subclasses.
        """
        with open(file_path, 'r', encoding='utf-8') as f:
            contents = f.read()
        return contents.split('\n')

    def _truncate_lines(self, lines, max_lines):
        """
        Truncate lines if needed and return (contents, preview_type).
        Helper method that can be reused by subclasses.
        """
        if len(lines) > max_lines:
            preview_type = PreviewType.PARTIAL
            contents = '\n'.join(lines[:max_lines]) + f"\n... ({len(lines) - max_lines} more lines)"
        else:
            preview_type = PreviewType.FULL
            contents = '\n'.join(lines)
        return contents, preview_type

    def _get_mime_type(self, file_extension):
        """
        Get the appropriate MIME type for the file extension.
        Can be overridden by subclasses for custom MIME type logic.
        """
        return self.EXTENSION_MIME_TYPES.get(file_extension, self.DEFAULT_MIME_TYPE)

    def _handle(self, file_path, file_extension=None):
        """
        Handle text file processing.

        Subclasses can override this method to add custom behavior while
        reusing helper methods like _read_file_lines(), _truncate_lines(), etc.
        """
        lines = self._read_file_lines(file_path)
        max_lines = self._get_extension_config(file_extension, 'max_lines')
        contents, preview_type = self._truncate_lines(lines, max_lines)
        mime_type = self._get_mime_type(file_extension)

        return contents, preview_type, mime_type


