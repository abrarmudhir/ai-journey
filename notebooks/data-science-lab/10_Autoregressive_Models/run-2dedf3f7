def parse_handler_configs(argv):
    """
    Parse handler configuration arguments from command line.

    Looks for arguments in the format: --HandlerName.key=value
    Returns (handler_configs, remaining_args)

    Example:
        --TextHandler.python__max_lines=1500
        --JupyterNotebookHandler.max_cells=50
    """
    handler_configs = {}
    remaining_args = []

    for arg in argv:
        # Check if it's a handler config argument
        if arg.startswith("--") and "." in arg and "=" in arg:
            # Remove leading --
            arg = arg[2:]

            # Split into handler name and rest
            if "." not in arg:
                remaining_args.append("--" + arg)
                continue

            handler_name, rest = arg.split(".", 1)

            if "=" not in rest:
                remaining_args.append("--" + arg)
                continue

            key, value = rest.split("=", 1)

            # Type conversion: try int, then bool, then string
            if value.isdigit():
                value = int(value)
            elif value.lower() in ('true', 'false'):
                value = value.lower() == 'true'

            # Add to handler configs
            handler_configs.setdefault(handler_name, {})[key] = value
        else:
            remaining_args.append(arg)

    return handler_configs, remaining_args


def main():
    import argparse
    import sys

    # Parse handler configs first
    handler_configs, remaining_args = parse_handler_configs(sys.argv[1:])

    # Create base config with command-line overrides
    config = CONFIG.copy()

    # Merge handler configs into main config
    for handler_name, handler_config in handler_configs.items():
        config[handler_name] = {**config.get(handler_name, {}), **handler_config}

    parser = argparse.ArgumentParser(
        description="Generate static JSON representation of filesystem",
        epilog="""
Handler Configuration:
  You can configure handlers with --HandlerName.key=value syntax:
    --TextHandler.python__max_lines=1500
    --TextHandler.javascript__max_lines=800
    --JupyterNotebookHandler.max_cells=50
        """
    )
    parser.add_argument("--base_path", default="/app", help="Base path to generate tree from")
    parser.add_argument("--max-depth", type=int, default=CONFIG["MAX_DEPTH"], help="Maximum depth to traverse")
    parser.add_argument("--max-size", type=int, default=CONFIG["MAX_SIZE_IN_BYTES"], help="Maximum file size to process (bytes)")
    parser.add_argument("--include-hidden", action="store_true", help="Include hidden files and directories")
    parser.add_argument("--output", "-o", help="Output file (default: stdout)")

    args = parser.parse_args(remaining_args)

    # Update config with command-line arguments
    config['MAX_DEPTH'] = args.max_depth
    config['MAX_SIZE_IN_BYTES'] = args.max_size
    config['INCLUDE_HIDDEN'] = args.include_hidden

    tree = generate_filesystem_tree(
        args.base_path,
        config=config
    )

    json_output = json.dumps(tree.to_dict(), indent=2)

    result = {
        "success": True,
        "stdout": json_output,
        "stderr": ""
    }
    print(json.dumps(result))


if __name__ == "__main__":
    main()