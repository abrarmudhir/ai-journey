HANDLERS = [
    JupyterNotebookHandler,
    PNGHandler,
    JPGHandler,
    GIFHandler,
    TextHandler,
    BinaryHandler,
]


class HandlerRegistry:
    def __init__(self, config, handlers=None):
        self.config = config
        self.mime_type_to_handler = {}
        self.file_extension_to_handler = {}
        self._register_handlers(handlers or HANDLERS)

    def _mimetype_split(self, mime_type):
        parts = mime_type.split('/', 1)
        assert len(parts) > 0, "Invalid mime type"
        if len(parts) == 1:
            return parts[0], ""
        return parts

    def _register_handlers(self, handlers):
        for HandlerClass in handlers:
            handler = HandlerClass(self.config)

            for mime_type in HandlerClass.MIME_TYPES:
                part_1, part_2 = self._mimetype_split(mime_type)
                self.mime_type_to_handler.setdefault((part_1, part_2), [])
                self.mime_type_to_handler[(part_1, part_2)].append(handler)

            for file_extension in HandlerClass.FILE_EXTENSIONS:
                self.file_extension_to_handler.setdefault(file_extension, [])
                self.file_extension_to_handler[file_extension].append(handler)

    def find_handler(self, mime_type, file_extension):
        """
        Find the appropriate handler for a file.

        Priority:
        1. Exact mime type match
        2. Supertype mime type match (e.g., "image/")
        3. File extension match

        Returns:
            BaseHandler or None
        """
        # import ipdb; ipdb.set_trace()
        if mime_type:
            part_1, part_2 = self._mimetype_split(mime_type)
            if (part_1, part_2) in self.mime_type_to_handler:
                return self.mime_type_to_handler[(part_1, part_2)][0]
            elif (part_1, "") in self.mime_type_to_handler:
                return self.mime_type_to_handler[(part_1, "")][0]
        # Try file extension match
        if file_extension and file_extension in self.file_extension_to_handler:
            return self.file_extension_to_handler[file_extension][0]

        return None


def get_file_info(file_path, follow_symlinks=True):
    """Get basic file information."""
    stat_info = file_path.stat() if follow_symlinks else file_path.lstat()
    return {
        'size': stat_info.st_size,
        'last_modified': datetime.fromtimestamp(
            stat_info.st_mtime,
            tz=timezone.utc
        ).isoformat()
    }


def process_symlink(symlink_path, visited_paths):
    """Process a symlink and return a Node with symlink information."""
    try:
        target = symlink_path.resolve()
        target_str = str(target)

        # Check for circular reference
        if target_str in visited_paths:
            return Node(
                name=symlink_path.name,
                path=str(symlink_path),
                extension=symlink_path.suffix.lower(),
                type="symlink",
                symlink_info=SymlinkInfo(
                    target=target_str,
                    target_exists=False,
                    is_broken=False,
                    is_circular=True
                )
            )

        # Check if target exists
        target_exists = target.exists()

        # Get file info for the symlink itself (not the target)
        info = get_file_info(symlink_path, follow_symlinks=False)

        return Node(
            name=symlink_path.name,
            path=str(symlink_path),
            extension=symlink_path.suffix.lower(),
            type="symlink",
            size=info['size'],
            last_modified=info['last_modified'],
            symlink_info=SymlinkInfo(
                target=target_str,
                target_exists=target_exists,
                is_broken=not target_exists,
                is_circular=False
            )
        )
    except Exception:
        # Handle cases where we can't resolve the symlink
        return Node(
            name=symlink_path.name,
            path=str(symlink_path),
            extension=symlink_path.suffix.lower(),
            type="symlink",
            symlink_info=SymlinkInfo(
                target="<unresolvable>",
                target_exists=False,
                is_broken=True,
                is_circular=False
            )
        )


def process_file(file_path, handler_registry, config, visited_paths=None):
    """Process a single file and create a Node."""
    if visited_paths is None:
        visited_paths = set()

    # Check if this is a symlink first
    if file_path.is_symlink():
        return process_symlink(file_path, visited_paths)

    info = get_file_info(file_path)
    max_size = config['MAX_SIZE_IN_BYTES']

    # Guess mime type
    mime_type, _ = mimetypes.guess_type(str(file_path))
    file_extension = file_path.suffix.lower()

    # Initialize defaults
    preview = None

    # Check if file size is within limits before invoking handler
    if max_size == -1 or info['size'] <= max_size:
        handler = handler_registry.find_handler(mime_type, file_extension)

        if handler:
            try:
                preview = handler.handle(str(file_path), file_extension=file_extension)
            except Exception:
                # If handler fails, fall back to defaults
                preview = FilePreview(
                    contents="",
                    preview_type=PreviewType.ERROR,
                    mime_type=mime_type or "application/octet-stream"
                )

    return Node(
        path=str(file_path),
        name=file_path.name,
        extension=file_extension,
        type="file",
        size=info['size'],
        last_modified=info['last_modified'],
        preview=preview
    )


def process_directory(dir_path, handler_registry, config, current_depth=0, visited_paths=None):
    """Process a directory recursively and create a Node tree."""
    if visited_paths is None:
        visited_paths = set()

    # Check if this is a symlink to a directory
    if dir_path.is_symlink():
        return process_symlink(dir_path, visited_paths)

    max_depth = config['MAX_DEPTH']
    include_hidden = config['INCLUDE_HIDDEN']

    # Add current directory to visited paths (circular reference protection)
    resolved_path = str(dir_path.resolve())
    if resolved_path in visited_paths:
        # Return directory node without children to avoid infinite recursion
        info = get_file_info(dir_path)
        return Node(
            path=str(dir_path),
            name=dir_path.name,
            extension="",
            type="dir",
            size=info['size'],
            last_modified=info['last_modified'],
            children=None
        )

    visited_paths.add(resolved_path)
    info = get_file_info(dir_path)

    children = []

    if current_depth < max_depth:
        for item in sorted(dir_path.iterdir()):
            # Skip hidden files if configured
            if not include_hidden and item.name.startswith('.'):
                continue

            # Skip "run-UUID" files used during exec_run()
            if item.is_file() and item.name.startswith("run-"):
                continue

            # Skip __pycache__ directories
            if item.is_dir() and item.name == "__pycache__":
                continue

            # Check for symlink first, before is_file() or is_dir()
            if item.is_symlink():
                node = process_symlink(item, visited_paths)
                children.append(node)
            elif item.is_file():
                node = process_file(item, handler_registry, config, visited_paths)
                children.append(node)
            elif item.is_dir():
                # Create a copy of visited_paths for this branch
                node = process_directory(
                    item,
                    handler_registry,
                    config,
                    current_depth + 1,
                    visited_paths.copy()
                )
                children.append(node)

    return Node(
        path=str(dir_path),
        name=dir_path.name,
        extension="",  # Directories don't have extensions
        type="dir",
        size=info['size'],
        last_modified=info['last_modified'],
        children=children if children else None
    )


def generate_filesystem_tree(base_path, config):
    """
    Generate a JSON representation of the filesystem starting from base_path.

    Args:
        base_path: Path to start traversal
        max_depth: Maximum depth to traverse
        include_hidden: Whether to include hidden files/directories
        max_size: Maximum file size to process (bytes)
        config: Handler configuration dictionary

    Returns:
        Node: Root node of the filesystem tree
    """

    path = Path(base_path).resolve()
    handler_registry = HandlerRegistry(config)

    if not path.exists():
        raise ValueError(f"Path does not exist: {base_path}")

    if path.is_file():
        return process_file(path, handler_registry, config)
    else:
        return process_directory(path, handler_registry, config)


